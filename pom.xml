<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.scalekit</groupId>
    <artifactId>scalekit-sdk-java</artifactId>
    <version>2.5.0</version>

    <packaging>jar</packaging>

    <developers>
        <developer>
            <name>Hrishikesh Premkumar</name>
            <email>hrishikesh.premkumar@scalekit.com</email>
            <organization>Scalekit</organization>
            <organizationUrl>https://www.scalekit.com</organizationUrl>
        </developer>
        <developer>
            <name>Vishal Dhawani</name>
            <email>vishal.dhawani@scalekit.com</email>
            <organization>Scalekit</organization>
            <organizationUrl>https://www.scalekit.com</organizationUrl>
        </developer>
        <developer>
            <name>Avinash Kamath</name>
            <email>avinash.kamath@scalekit.com</email>
            <organization>Scalekit</organization>
            <organizationUrl>https://www.scalekit.com</organizationUrl>
        </developer>
    </developers>


    <scm>
        <connection>scm:git:git@github.com:scalekit-inc/scalekit-sdk-java.git</connection>
        <developerConnection>scm:git:git@github.com:scalekit-inc/scalekit-sdk-java.git</developerConnection>
        <url>https://github.com/scalekit-inc/scalekit-sdk-java.git</url>
    </scm>



    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>



    <name>Scalekit Java</name>
    <description>Scalekit client library for Scalekit API</description>
    <url>https://github.com/scalekit-inc/scalekit-sdk-java</url>

    <organization>
        <name>Scalekit</name>
        <url>https://www.scalekit.com</url>
    </organization>


    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- javac's release option also checks API usage against the Java 8 class library;
             a source/target pair does not. It applies to main and test sources alike. -->
        <maven.compiler.release>8</maven.compiler.release>
        <io.grpc.version>1.75.0</io.grpc.version>

        <!-- API compatibility check (japicmp) against a released version on Maven Central.
             Off by default so a plain build never needs the network for it. `make api-compat`
             downloads the released jar of japicmp.oldVersion (CI passes the latest v* tag)
             to japicmp.oldJar and enables the check. -->
        <japicmp.skip>true</japicmp.skip>
        <japicmp.oldVersion>2.5.0</japicmp.oldVersion>
        <japicmp.oldJar>${project.build.directory}/japicmp-baseline/scalekit-sdk-java-${japicmp.oldVersion}.jar</japicmp.oldJar>
        <!-- scripts/check-jar-contents.sh as part of the build (see exec-maven-plugin). -->
        <jarcheck.skip>true</jarcheck.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <scope>runtime</scope>
            <version>${io.grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>3.25.5</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${io.grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.5</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${io.grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>build.buf</groupId>
            <artifactId>protovalidate</artifactId>
            <version>0.2.1</version>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.9.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.8</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.14</version>
        </dependency>
        <dependency>
            <groupId>org.bitbucket.b_c</groupId>
            <artifactId>jose4j</artifactId>
            <version>0.9.6</version>
        </dependency>
    </dependencies>



    <build>
        <resources>
            <resource>
                <directory>.</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.9.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <!-- false: an upload waits in the Central Portal until it is published
                             by hand. Follow-up once a release from .github/workflows/release.yml
                             has been inspected there: autoPublish true and
                             <waitUntil>published</waitUntil>, so the approved run publishes. -->
                        <autoPublish>false</autoPublish>
                    </configuration>
                </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.7.0</version>
                <!-- Applies to a direct `mvn javadoc:javadoc` run, which `make javadoc` and CI
                     use to catch broken {@link} references before they reach a release build.
                     The `missing` group is off because generated gRPC/protobuf sources carry
                     no doc comments. -->
                <configuration>
                    <doclint>all,-missing</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <!-- A release must not be blocked by doc lint; CI already enforces it
                             via `make javadoc`. Overrides the plugin-level setting above. -->
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-source</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Pinned so the test runner does not change with the Maven version. `make unit-test`
                 passes -DexcludedGroups=live (tests tagged @Tag("live") need a real environment)
                 and, in CI, -Djvm=<path to java> to run the compiled tests on each supported JDK. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <!-- Relocate common libraries -->
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>com.scalekit.shaded.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google</pattern>
                                    <shadedPattern>com.scalekit.shaded.google</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.grpc</pattern>
                                    <shadedPattern>com.scalekit.shaded.grpc</shadedPattern>
                                </relocation>
                            </relocations>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.projectlombok:lombok</exclude>
                                    <exclude>javax.annotation:javax.annotation-api</exclude>
                                    <exclude>org.slf4j:slf4j-api</exclude>
                                    <exclude>org.slf4j:slf4j-nop</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/LICENSE.*</exclude>
                                        <exclude>META-INF/NOTICE.*</exclude>
                                        <exclude>META-INF/*</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!-- Module descriptors of bundled dependencies. The shaded jar
                                             is not Multi-Release, so no JVM reads them; they only
                                             misdescribe this jar to module-aware tools. -->
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
              </plugin>

            <!-- Runs scripts/check-jar-contents.sh on the shaded jar before it is signed and
                 deployed. Off by default (it needs bash and unzip); the release workflow passes
                 -Djarcheck.skip=false, and `make jar-check` runs the script directly. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>check-jar-contents</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${jarcheck.skip}</skip>
                            <executable>${project.basedir}/scripts/check-jar-contents.sh</executable>
                            <arguments>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- API compatibility with the released version japicmp.oldVersion (make api-compat).
                 A package filter matches the package and its subpackages.
                 - api: everything in com.scalekit except the packages below; any binary or
                   source incompatible change fails the build.
                 - api-clients: com.scalekit.api (service interfaces and implementations); the
                   same rule, except that adding a method to a service interface is allowed.
                   These interfaces are implemented only by the SDK (callers get them from
                   ScalekitClient), and new operations are added to them.
                 - grpc: generated proto classes, report only. A generated type that appears
                   in an SDK signature is still checked through that signature.
                 Relocated dependencies (com.scalekit.shaded) are not API. -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <version>0.26.3</version>
                <configuration>
                    <!-- A file, not a dependency: with the pom at the released version, Maven
                         would resolve the dependency to this build's own jar. -->
                    <oldVersion>
                        <file>
                            <path>${japicmp.oldJar}</path>
                        </file>
                    </oldVersion>
                    <skip>${japicmp.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>api</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <parameter>
                                <includes>
                                    <include>com.scalekit</include>
                                </includes>
                                <excludes>
                                    <exclude>com.scalekit.api</exclude>
                                    <exclude>com.scalekit.grpc</exclude>
                                    <exclude>com.scalekit.shaded</exclude>
                                </excludes>
                                <onlyModified>true</onlyModified>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                            </parameter>
                        </configuration>
                    </execution>
                    <execution>
                        <id>api-clients</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <parameter>
                                <includes>
                                    <include>com.scalekit.api</include>
                                </includes>
                                <onlyModified>true</onlyModified>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <overrideCompatibilityChangeParameters>
                                    <overrideCompatibilityChangeParameter>
                                        <compatibilityChange>METHOD_ADDED_TO_INTERFACE</compatibilityChange>
                                        <binaryCompatible>true</binaryCompatible>
                                        <sourceCompatible>true</sourceCompatible>
                                        <semanticVersionLevel>MINOR</semanticVersionLevel>
                                    </overrideCompatibilityChangeParameter>
                                    <overrideCompatibilityChangeParameter>
                                        <compatibilityChange>METHOD_ABSTRACT_ADDED_IN_IMPLEMENTED_INTERFACE</compatibilityChange>
                                        <binaryCompatible>true</binaryCompatible>
                                        <sourceCompatible>true</sourceCompatible>
                                        <semanticVersionLevel>MINOR</semanticVersionLevel>
                                    </overrideCompatibilityChangeParameter>
                                </overrideCompatibilityChangeParameters>
                            </parameter>
                        </configuration>
                    </execution>
                    <execution>
                        <id>grpc</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <parameter>
                                <includes>
                                    <include>com.scalekit.grpc</include>
                                </includes>
                                <onlyModified>true</onlyModified>
                                <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                            </parameter>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
